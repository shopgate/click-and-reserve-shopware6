{% sw_extends '@Storefront/storefront/page/product-detail/buy-widget-form.html.twig' %}
{% block page_product_detail_buy_button %}
    {% set sgCarBlacklist = config('SgateClickAndReserveSW6.config.productBlacklist')|default('')|replace({"\r\n": ",", "\n": ",", "\r": ",", " ": ""})|split(',')|filter(v => v is not empty) %}
    {% set sgCarBlocked = page.product.id in sgCarBlacklist or (page.product.parentId is defined and page.product.parentId and page.product.parentId in sgCarBlacklist) %}
    {% if config('SgateClickAndReserveSW6.config.displayType') != 'disabled' and not sgCarBlocked %}
    <style type="text/css">
        .rr-wrapper {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
        }
        #rr-reserve-button {
            flex-grow: 1;
            margin: 4px;
        }
        #rr-omni-reserve-button{
            width: 100%;
            line-height: 38px;
            font-size: 1rem;
        }
        .rr-cart {
            margin: 4px;
            flex-grow: 1;
        }

        #rr-omni #rr-omni-custom, #rr-omni-reserve-button {
            {{ shopware.config.SgateClickAndReserveSW6.config.colors }}
        }
    </style>
   <div class="rr-wrapper">
       <div class="rr-cart">
            {{ parent() }}
        </div>
        <div id="rr-reserve-button"></div>
        <div id="rr-live-inventory"></div>
   </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
