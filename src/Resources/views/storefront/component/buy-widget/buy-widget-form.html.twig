{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget-form.html.twig' %}
{% block buy_widget_buy_button_container %}
    {{ parent() }}
    {% set sgCarBlacklist = config('SgateClickAndReserveSW6.config.productBlacklist')|default('')|replace({"\r\n": ",", "\n": ",", "\r": ",", " ": ""})|split(',')|map(v => v|trim)|filter(v => v is not empty) %}
    {% set sgCarBlocked = page.product.id in sgCarBlacklist or (page.product.parentId is defined and page.product.parentId and page.product.parentId in sgCarBlacklist) %}
    {% if config('SgateClickAndReserveSW6.config.displayType') != 'disabled' and not sgCarBlocked %}
        <style type="text/css">
            .rr-wrapper {
                align-items: center;
            }
            #rr-reserve-button {
                flex-grow: 1;
                margin: 4px;
            }
            #rr-omni-reserve-button{
                width: 100%;
                line-height: 38px;
                font-size: 1rem;
            }

            #rr-omni #rr-omni-custom, #rr-omni-reserve-button, #rr-inventory {
            {{ config('SgateClickAndReserveSW6.config.colors')|raw }}
            }
        </style>
        <div class="rr-wrapper">
            <div id="rr-reserve-button"></div>
            <div id="rr-live-inventory"></div>
        </div>
    {% endif %}
{% endblock %}
